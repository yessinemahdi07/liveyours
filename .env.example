# Supabase Database URL
DATABASE_URL=
# AI Providers
OMNIROUTE_URL=http://127.0.0.1:20128/v1/chat/completions
OMNIROUTE_API_KEY=your_omniroute_api_key
# Optional local fallback. Start FreeLLMAPI on this PC and add its unified key here.
FREELLMAPI_URL=http://127.0.0.1:3001/v1/chat/completions
FREELLMAPI_API_KEY=
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openrouter/free
# Private owner coaching context; only sent with OpenRouter completions.
LIVEYOURS_COACH_PROFILE=
BYTEZ_API_KEY=your_bytez_key
BYTEZ_MODEL=Qwen/Qwen3-4B
LLM7_API_KEY=your_llm7_key
LLM7_MODEL=gpt-4o-mini-2024-07-18
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_MODEL=models/gemini-3.1-flash-lite
# Cloud AI providers receive personal prompts and context. Leave disabled for local-only use.
CLOUD_AI_FALLBACK=false
# Offline trip estimates use these values; configure your starting city locally.
HOME_CITY=
FUEL_PRICE_TND_PER_LITER=2.5
# Keep empty for local-only development; Render generates a password automatically.
APP_USERNAME=liveyours
APP_PASSWORD=
